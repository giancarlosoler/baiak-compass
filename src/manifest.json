{
  "manifest_version": 3,
  "name": "Baiak Compass v0.6.6 Advisor + Medición Visual TEST",
  "version": "0.6.6",
  "description": "Recomendaciones automáticas por XP, gold y Hard Mode: usa estimaciones hasta completar 5 minutos y luego usa el promedio real persistente.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://baiakidle.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Baiak Compass",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://baiakidle.com/*"
      ],
      "js": [
        "hunt-estimates.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
